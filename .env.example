# ==========================================
# ORACLE TRADING AGENT ENVIRONMENT VARIABLES
# ==========================================

# LLM Provider Configuration (Groq / Gemini / AIMLAPI)
LLM_PROVIDER=groq

# Groq Configuration (Ultra-Fast 120B Inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini Configuration (Massive 1M Context)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# AIML API Configuration (Backup Fallback)
AIML_API_KEY=your_aiml_api_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1
AI_MODEL=openai/gpt-4o-mini

# Alpaca Paper Trading API Credentials
APCA_API_KEY_ID=your_alpaca_key_id
APCA_API_SECRET_KEY=your_alpaca_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Trading & Risk Configuration
INITIAL_BALANCE=100000
MAX_LOSS_PER_TRADE=150
DAILY_LOSS_LIMIT=500
PROFIT_TARGET_PERCENT=50
ACCOUNT_FLOOR_BALANCE=95000
